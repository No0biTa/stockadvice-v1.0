    ]
  },
  {
    name: 'Perbankan',
    stocks: [
      { symbol: 'BBCA.JK', name: 'Bank Central Asia' },
      { symbol: 'BBRI.JK', name: 'Bank Rakyat Indonesia' },
      { symbol: 'BMRI.JK', name: 'Bank Mandiri' },
      { symbol: 'BBNI.JK', name: 'Bank Negara Indonesia' },
