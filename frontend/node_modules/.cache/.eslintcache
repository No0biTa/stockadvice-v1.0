:"85","endLine":220,"endColumn":27},{"ruleId":"78","severity":1,"message":"86","line":415,"column":6,"nodeType":"87","endLine":415,"endColumn":22,"suggestions":"88"},{"ruleId":"78","severity":1,"message":"89","line":780,"column":6,"nodeType":"87","endLine":780,"endColumn":39,"suggestions":"90"},{"ruleId":"78","severity":1,"message":"91","line":972,"column":6,"nodeType":"87","endLine":972,"endColumn":8,"suggestions":"92"},{"ruleId":"93","severity":1,"message":"94","line":1222,"column":21,"nodeType":"95","messageId":"96","endLine":1222,"endColumn":30},"react-hooks/exhaustive-deps","The 'updateDropdownPosition' function makes the dependencies of useCallback Hook (at line 850) change on every render. To fix this, wrap the definition of 'updateDropdownPosition' in its own useCallback() Hook.","VariableDeclarator",["97"],"no-unused-vars","'navbarHeight' is assigned a value but never used.","Identifier","unusedVar","React Hook useEffect has a missing dependency: 'updateDropdownPosition'. Either include it or remove the dependency array.","ArrayExpression",["98"],"React Hook useEffect has a missing dependency: 'preloadedCategories.popular'. Either include it or remove the dependency array.",["99"],"React Hook useCallback has a missing dependency: 'handleStockSelect'. Either include it or remove the dependency array.",["100"],"no-dupe-keys","Duplicate key 'maxHeight'.","ObjectExpression","unexpected",{"desc":"101","fix":"102"},{"desc":"103","fix":"104"},{"desc":"105","fix":"106"},{"desc":"107","fix":"108"},"Wrap the definition of 'updateDropdownPosition' in its own useCallback() Hook.",{"range":"109","text":"110"},"Update the dependencies array to be: [showStocksList, updateDropdownPosition]",{"range":"111","text":"112"},"Update the dependencies array to be: [preloadStockData, popularStocks, preloadedCategories.popular]",{"range":"113","text":"114"},"Update the dependencies array to be: [handleStockSelect]",{"range":"115","text":"116"},[6944,8798],"useCallback(() => {\r\n    if (inputGroupRef.current && showStocksList) {\r\n      const viewportWidth = window.innerWidth;\r\n      const viewportHeight = window.innerHeight;\r\n      \r\n      // Untuk layar kecil, gunakan design bottom sheet\r\n      if (viewportWidth < 576) {\r\n         // Deteksi apakah keyboard terbuka\r\n        const keyboardHeight = window.innerHeight - (window.visualViewport?.height || window.innerHeight);\r\n        const isKeyboardOpen = keyboardHeight > 150;\r\n      \r\n        // Untuk mobile, gunakan layout bottom sheet\r\n        setDropdownPosition({\r\n          top: isKeyboardOpen ? '5%' : '15%',\r\n          bottom: 'auto',\r\n          left: 0,\r\n          width: '100%'\r\n        });\r\n      } else {\r\n        // Untuk layar yang lebih besar\r\n        const rect = inputGroupRef.current.getBoundingClientRect();\r\n        const navbarElement = document.querySelector('header, nav');\r\n        const navbarHeight = navbarElement ? navbarElement.getBoundingClientRect().height : 60;\r\n        \r\n        // Hitung posisi dropdown\r\n        let topPosition = rect.bottom;\r\n        let leftPosition = rect.left;\r\n        \r\n        // Batasi lebar dropdown\r\n        let dropdownWidth = Math.min(600, Math.max(320, rect.width));\r\n        \r\n        // Pastikan dropdown tidak keluar dari viewport\r\n        if (leftPosition + dropdownWidth > viewportWidth) {\r\n          leftPosition = Math.max(10, viewportWidth - dropdownWidth - 10);\r\n        }\r\n        \r\n        // Pastikan posisi top tidak terlalu rendah\r\n        const maxTop = viewportHeight - 100;\r\n        if (topPosition > maxTop) {\r\n          topPosition = rect.top - 320; // Posisikan di atas input\r\n        }\r\n        \r\n        setDropdownPosition({\r\n          top: topPosition,\r\n          bottom: 'auto',\r\n          left: leftPosition,\r\n          width: dropdownWidth\r\n        });\r\n      }\r\n    }\r\n  })",[15334,15350],"[showStocksList, updateDropdownPosition]",[28267,28300],"[preloadStockData, popularStocks, preloadedCategories.popular]",[34497,34499],"[handleStockSelect]"]