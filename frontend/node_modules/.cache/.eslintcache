,"endLine":216,"endColumn":27},{"ruleId":"77","severity":1,"message":"85","line":366,"column":6,"nodeType":"86","endLine":366,"endColumn":22,"suggestions":"87"},{"ruleId":"77","severity":1,"message":"88","line":727,"column":6,"nodeType":"86","endLine":727,"endColumn":39,"suggestions":"89"},{"ruleId":"77","severity":1,"message":"90","line":919,"column":6,"nodeType":"86","endLine":919,"endColumn":8,"suggestions":"91"},"react-hooks/exhaustive-deps","The 'updateDropdownPosition' function makes the dependencies of useCallback Hook (at line 797) change on every render. To fix this, wrap the definition of 'updateDropdownPosition' in its own useCallback() Hook.","VariableDeclarator",["92"],"no-unused-vars","'navbarHeight' is assigned a value but never used.","Identifier","unusedVar","React Hook useEffect has a missing dependency: 'updateDropdownPosition'. Either include it or remove the dependency array.","ArrayExpression",["93"],"React Hook useEffect has a missing dependency: 'preloadedCategories.popular'. Either include it or remove the dependency array.",["94"],"React Hook useCallback has a missing dependency: 'handleStockSelect'. Either include it or remove the dependency array.",["95"],{"desc":"96","fix":"97"},{"desc":"98","fix":"99"},{"desc":"100","fix":"101"},{"desc":"102","fix":"103"},"Wrap the definition of 'updateDropdownPosition' in its own useCallback() Hook.",{"range":"104","text":"105"},"Update the dependencies array to be: [showStocksList, updateDropdownPosition]",{"range":"106","text":"107"},"Update the dependencies array to be: [preloadStockData, popularStocks, preloadedCategories.popular]",{"range":"108","text":"109"},"Update the dependencies array to be: [handleStockSelect]",{"range":"110","text":"111"},[6944,8555],"useCallback(() => {\r\n    if (inputGroupRef.current && showStocksList) {\r\n      const viewportWidth = window.innerWidth;\r\n      const viewportHeight = window.innerHeight;\r\n      \r\n      // Untuk layar kecil, gunakan design bottom sheet\r\n      if (viewportWidth < 576) {\r\n        // Untuk mobile, gunakan layout bottom sheet\r\n        setDropdownPosition({\r\n          top: 'auto',\r\n          bottom: 0,\r\n          left: 0,\r\n          width: '100%'\r\n        });\r\n      } else {\r\n        // Untuk layar yang lebih besar\r\n        const rect = inputGroupRef.current.getBoundingClientRect();\r\n        const navbarElement = document.querySelector('header, nav');\r\n        const navbarHeight = navbarElement ? navbarElement.getBoundingClientRect().height : 60;\r\n        \r\n        // Hitung posisi dropdown\r\n        let topPosition = rect.bottom;\r\n        let leftPosition = rect.left;\r\n        \r\n        // Batasi lebar dropdown\r\n        let dropdownWidth = Math.min(600, Math.max(320, rect.width));\r\n        \r\n        // Pastikan dropdown tidak keluar dari viewport\r\n        if (leftPosition + dropdownWidth > viewportWidth) {\r\n          leftPosition = Math.max(10, viewportWidth - dropdownWidth - 10);\r\n        }\r\n        \r\n        // Pastikan posisi top tidak terlalu rendah\r\n        const maxTop = viewportHeight - 100;\r\n        if (topPosition > maxTop) {\r\n          topPosition = rect.top - 320; // Posisikan di atas input\r\n        }\r\n        \r\n        setDropdownPosition({\r\n          top: topPosition,\r\n          bottom: 'auto',\r\n          left: leftPosition,\r\n          width: dropdownWidth\r\n        });\r\n      }\r\n    }\r\n  })",[13299,13315],"[showStocksList, updateDropdownPosition]",[26040,26073],"[preloadStockData, popularStocks, preloadedCategories.popular]",[32270,32272],"[handleStockSelect]"]